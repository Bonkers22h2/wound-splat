# --- Wound tissue segmentation (DFUTissue dataset) ---
# The DFUTissue data was granted for nonprofit academic use with NO
# REDISTRIBUTION (Prof. Zeyun Yu, 2026-09-04 — see docs/permissions/).
# THIS REPOSITORY IS PUBLIC, so the rule below denies everything under tissue/
# by default and allows only source code, runtime config and notes back in. A new image, mask
# or checkpoint therefore cannot be committed by accident.
tissue/**
!tissue/*.py
!tissue/*.md
!tissue/lib/
!tissue/lib/*.py
!tissue/tests/
!tissue/tests/*.py
!tissue/configs/
!tissue/configs/stats.json
!tissue/requirements.txt

# Dataset material and annotation work must always remain local.
# These explicit rules take priority over the source-code allowlist above.
/tissue/raw/
/tissue/annotation_work/
/tissue/checkpoints/
/tissue/outputs/
/tissue/datasets/
/tissue/results/
/tissue/**/[Ll]abeled/
/tissue/**/[Uu]nlabeled/
/tissue/**/[Uu]nlabelled/

# A clone of the upstream dataset repo, wherever it lands
DFUTissueSegNet/

# Trained weights and the training virtualenv — never commit either
tissue-venv/
*.pt
*.pth
*.ckpt

# Misc
filelist.txt
wound_salve.mp4
data/
gaussian-splatting/SIBR_viewers/
gaussian-splatting/submodules/diff-gaussian-rasterization/third_party/
gaussian-splatting/submodules/fused-ssim/

# Local research, thesis drafts, permissions and experiment outputs
/docs/
/experiments/
!/experiments/
/experiments/*
!/experiments/wagner_classification/
/experiments/wagner_classification/*
!/experiments/wagner_classification/*.md
!/experiments/wagner_classification/config.json
# Wagner source only; images, audit manifests and run outputs stay local.
/wagner/**
!/wagner/*.py
!/wagner/requirements.txt
!/wagner/tests/
!/wagner/tests/*.py
/tools/thesis/
/*.docx
/*_workplan_*.png

# Generated document previews and QA scratch directories
/_qa_*/
/qa_*/
/rendered_*/
/*_render_check/
